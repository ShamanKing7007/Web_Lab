# Database configuration
DB_USER=nix
DB_PASSWORD=sews
DB_NAME=Web_Labs

# Application configuration
DB_HOST=localhost
DB_PORT=5432
PORT=4200
APP_ENV=development
SWAGGER_ENABLED=true

# Redis cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_change_in_prod
REDIS_DB=0
CACHE_TTL_DEFAULT=300

# pgAdmin
PGADMIN_PASSWORD=admin

# JWT секреты
JWT_ACCESS_SECRET=super_secret_access_key_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_prod

# Время жизни токенов
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OAuth провайдер (VK ID или Yandex ID)
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
CALLBACK_URL=http://localhost:4200/auth/yandex/callback

# Какой провайдер используем (yandex или vk)
OAUTH_PROVIDER=yandex
